{
  "slug": "composer-attachments",
  "name": "Composer Attachments",
  "title": "输入附件",
  "category": "agents",
  "files": [
    "components/composer-attachments/composer-attachments.tsx"
  ],
  "description": "输入框的附件条：图片显示缩略图，文件显示类型图标、名称与大小；支持上传进度、失败重试与移除按钮，新附件以弹出动画出现，超出时横向滚动。",
  "keywords": [
    "attachments",
    "files",
    "upload",
    "thumbnail",
    "附件",
    "文件",
    "图片",
    "上传"
  ],
  "exports": [
    "ComposerAttachments",
    "ComposerAttachment"
  ],
  "demos": [
    {
      "file": "composer-attachments/overview.tsx",
      "title": "概览",
      "description": "图片、表格、PDF、上传中与上传失败的附件；悬停或聚焦时出现移除按钮。",
      "height": 180
    },
    {
      "file": "composer-attachments/upload.tsx",
      "title": "上传进度",
      "description": "更新 progress 与 status，文件卡底部的进度条会平滑前进。",
      "height": 200,
      "layout": "padded"
    }
  ],
  "notes": [
    "类型由 MIME 和扩展名判断：图片、PDF、表格、代码、压缩包、文档各有配色与图标。",
    "previewUrl 可用 URL.createObjectURL(file) 生成；没有时显示图片图标占位。",
    "触屏设备上移除按钮常驻显示。"
  ],
  "props": [
    {
      "component": "ComposerAttachments",
      "props": [
        {
          "name": "items",
          "type": "ComposerAttachmentItem[]",
          "description": "附件列表；为空时不渲染。",
          "required": true
        },
        {
          "name": "onRemove",
          "type": "(id: string) => void",
          "description": "传入后显示移除按钮。"
        },
        {
          "name": "onRetry",
          "type": "(id: string) => void",
          "description": "失败附件的重试。"
        },
        {
          "name": "labels",
          "type": "Partial<ComposerAttachmentsLabels>",
          "description": "覆盖内置文案。"
        }
      ]
    },
    {
      "component": "ComposerAttachmentItem",
      "props": [
        {
          "name": "id",
          "type": "string",
          "description": "唯一标识。",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "description": "文件名。",
          "required": true
        },
        {
          "name": "size",
          "type": "number",
          "description": "字节数。"
        },
        {
          "name": "type",
          "type": "string",
          "description": "MIME 类型。"
        },
        {
          "name": "previewUrl",
          "type": "string",
          "description": "图片缩略图地址。"
        },
        {
          "name": "status",
          "type": "\"uploading\" | \"done\" | \"error\"",
          "description": "状态。",
          "default": "\"done\""
        },
        {
          "name": "progress",
          "type": "number",
          "description": "上传进度 0–100。"
        },
        {
          "name": "error",
          "type": "ReactNode",
          "description": "失败原因。"
        }
      ]
    }
  ],
  "isNew": true
}
