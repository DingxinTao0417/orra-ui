{
  "slug": "skeleton",
  "name": "Skeleton",
  "title": "骨架屏",
  "category": "base",
  "files": [
    "components/skeleton/skeleton.tsx"
  ],
  "description": "骨架屏占位：矩形、圆形、文本行、胶囊四种形状，带柔和流光；提供段落与卡片预设，以及在加载完成后淡入真实内容的 SkeletonSwap。",
  "keywords": [
    "skeleton",
    "placeholder",
    "shimmer",
    "loading",
    "骨架屏",
    "占位",
    "加载"
  ],
  "exports": [
    "Skeleton",
    "SkeletonText",
    "SkeletonCard",
    "SkeletonSwap"
  ],
  "demos": [
    {
      "file": "skeleton/overview.tsx",
      "title": "概览",
      "layout": "padded",
      "height": 360
    },
    {
      "file": "skeleton/swap.tsx",
      "title": "骨架 → 内容",
      "description": "SkeletonSwap 在 loading 变为 false 时淡入真实内容，并只播报一次加载状态。",
      "height": 240
    }
  ],
  "notes": [
    "骨架元素是装饰性的（aria-hidden）；用 SkeletonSwap 包裹，或在区域上设置 aria-busy，让读屏只听到一次「内容加载中」。",
    "占位的形状和尺寸应尽量贴近真实内容，减少加载完成时的跳动。",
    "页面上骨架很多时可以传 still 关闭流光动画。"
  ],
  "props": [
    {
      "component": "Skeleton",
      "description": "其余属性透传给 <div>。",
      "props": [
        {
          "name": "shape",
          "type": "\"rect\" | \"circle\" | \"text\" | \"pill\"",
          "default": "\"rect\"",
          "description": "形状。"
        },
        {
          "name": "width",
          "type": "number | string",
          "description": "宽度，数字为 px。"
        },
        {
          "name": "height",
          "type": "number | string",
          "description": "高度，数字为 px；圆形只需给一个。"
        },
        {
          "name": "still",
          "type": "boolean",
          "default": "false",
          "description": "关闭流光。"
        }
      ]
    },
    {
      "component": "SkeletonText",
      "props": [
        {
          "name": "lines",
          "type": "number",
          "default": "3",
          "description": "行数。"
        },
        {
          "name": "lastLineWidth",
          "type": "string",
          "default": "\"62%\"",
          "description": "最后一行宽度。"
        },
        {
          "name": "size",
          "type": "\"sm\" | \"md\" | \"lg\"",
          "default": "\"md\"",
          "description": "行高预设。"
        }
      ]
    },
    {
      "component": "SkeletonCard",
      "props": [
        {
          "name": "media",
          "type": "boolean",
          "default": "false",
          "description": "顶部媒体区域。"
        },
        {
          "name": "avatar",
          "type": "boolean",
          "default": "true",
          "description": "头像 + 名字行。"
        },
        {
          "name": "lines",
          "type": "number",
          "default": "3",
          "description": "文本行数。"
        }
      ]
    },
    {
      "component": "SkeletonSwap",
      "props": [
        {
          "name": "loading",
          "type": "boolean",
          "required": true,
          "description": "为 true 时显示 fallback。"
        },
        {
          "name": "fallback",
          "type": "ReactNode",
          "required": true,
          "description": "占位内容。"
        },
        {
          "name": "children",
          "type": "ReactNode",
          "required": true,
          "description": "真实内容。"
        },
        {
          "name": "labels",
          "type": "Partial<SkeletonLabels>",
          "description": "覆盖「内容加载中」文案。"
        }
      ]
    }
  ]
}
