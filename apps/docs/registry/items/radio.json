      "props": [
        {
          "name": "label",
          "type": "ReactNode",
          "description": "字段标签。"
        },
        {
          "name": "description",
          "type": "ReactNode",
          "description": "标签下方的辅助说明。"
        },
        {
          "name": "errorMessage",
          "type": "ReactNode | ((v: ValidationResult) => ReactNode)",
