        {
          "name": "value",
          "type": "string",
          "description": "选项值。"
        },
        {
          "name": "children",
          "type": "ReactNode",
          "description": "标签文字。"
        },
        {
          "name": "description",
          "type": "ReactNode",
          "description": "说明文字。"
        },
        {
          "name": "icon",
          "type": "ReactNode",
          "description": "卡片样式的前置图标。"
        },
        {
          "name": "aside",
